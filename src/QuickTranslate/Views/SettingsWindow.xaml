<Window x:Class="QuickTranslate.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:QuickTranslate.Models"
        mc:Ignorable="d"
        Title="Settings"
        Icon="pack://application:,,,/Assets/icon.ico"
        Width="600"
        Height="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <DataTemplate DataType="{x:Type models:LanguageOption}">
            <TextBlock Text="{Binding DisplayName}"/>
        </DataTemplate>

        <Style x:Key="SettingsPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#666666"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="8"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBackgroundBrush}" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1" 
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/> <!-- Compact Title Bar -->
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/> <!-- Compact Footer -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="8,8,0,0">
                <Grid>
                    <TextBlock Text="Options" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               FontSize="{StaticResource FontSizeLarge}"
                               VerticalAlignment="Center" 
                               Margin="12,0,0,0"/>
                    <Button Style="{StaticResource WindowHeaderCloseButtonStyle}" 
                            Click="CloseButton_Click" 
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Close">
                        <Path Style="{StaticResource IconPathStyle}"
                              Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                              Height="10" Width="10"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar -->
                <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Background="#252526">
                    <ListBox ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategory}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0,4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="Padding" Value="12,6"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="BorderThickness" Value="2,0,0,0"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" 
                                                    Background="Transparent" 
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>

                <!-- Right Content Area -->
                <ScrollViewer Grid.Column="1" 
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0">
                    <Grid Margin="12,12,12,0">
                    
                    <!-- Basics Section -->
                    <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource CategoryToVisibility}, ConverterParameter=Basics}">
                        <GroupBox Header="General" Style="{StaticResource SettingsGroupBoxStyle}">
                            <Grid Margin="12,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>
                                
                                <CheckBox Grid.Row="0" Grid.ColumnSpan="2" 
                                          Content="Start with Windows" 
                                          IsChecked="{Binding StartWithWindows}"
                                          Style="{StaticResource SettingsCheckBoxStyle}"
                                          Margin="0,4,0,8"/>
                                
                                <TextBlock Grid.Row="1" Text="Window opacity:" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Slider Grid.Row="1" Grid.Column="1" 
                                        Minimum="0.3" Maximum="1.0" 
                                        Value="{Binding WindowOpacity}"
                                        VerticalAlignment="Center"
                                        TickFrequency="0.1"
                                        IsSnapToTickEnabled="True"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>

                    <!-- Hotkeys Section -->
                    <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource CategoryToVisibility}, ConverterParameter=Hotkeys}">
                        <GroupBox Header="Shortcuts" Style="{StaticResource SettingsGroupBoxStyle}">
                            <Grid Margin="12,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>

                                <!-- Action Name -->
                                <TextBlock Grid.Row="0" Grid.Column="0" 
                                           Text="Translate selection" 
                                           VerticalAlignment="Center" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                
                                <!-- Clickable Hotkey Cell -->
                                <Button Grid.Row="0" Grid.Column="1" 
                                        Content="{Binding Hotkey}"
                                        Click="EditHotkey_Click"
                                        MinWidth="80"
                                        Padding="8,4"
                                        HorizontalContentAlignment="Center"
                                        ToolTip="Click to change hotkey">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource WindowHeaderButtonStyle}">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Pronunciation Action -->
                                <TextBlock Grid.Row="1" Grid.Column="0" 
                                           Text="Pronounce word" 
                                           VerticalAlignment="Center" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>

                                <!-- Pronunciation Hotkey Button -->
                                <Button Grid.Row="1" Grid.Column="1" 
                                        Content="{Binding PronunciationHotkey}"
                                        Click="EditPronunciationHotkey_Click"
                                        MinWidth="80"
                                        Padding="8,4"
                                        HorizontalContentAlignment="Center"
                                        ToolTip="Click to change hotkey">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource WindowHeaderButtonStyle}">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- OCR Action -->
                                <TextBlock Grid.Row="2" Grid.Column="0" 
                                           Text="OCR Text Recognition" 
                                           VerticalAlignment="Center" 
                                           Foreground="{StaticResource TextPrimaryBrush}"/>

                                <!-- OCR Hotkey Button -->
                                <Button Grid.Row="2" Grid.Column="1" 
                                        Content="{Binding OcrHotkey}"
                                        Click="EditOcrHotkey_Click"
                                        MinWidth="80"
                                        Padding="8,4"
                                        HorizontalContentAlignment="Center"
                                        ToolTip="Click to change hotkey">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource WindowHeaderButtonStyle}">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </GroupBox>
                    </StackPanel>

                    <!-- Languages Section -->
                    <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource CategoryToVisibility}, ConverterParameter=Languages}">
                        <GroupBox Header="Auto-detect languages" Style="{StaticResource SettingsGroupBoxStyle}">
                            <Grid Margin="12,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Source language:" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          ItemsSource="{Binding AvailableLanguages}"
                                          SelectedValue="{Binding DefaultSourceLanguage}"
                                          SelectedValuePath="Code"
                                          ItemTemplate="{StaticResource LanguageItemTemplate}"
                                          Style="{StaticResource SettingsComboBoxStyle}"
                                          VerticalAlignment="Center"
                                          Margin="0,2"/>

                                <TextBlock Grid.Row="1" Text="Target language:" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <ComboBox Grid.Row="1" Grid.Column="1"
                                          ItemsSource="{Binding AvailableLanguages}"
                                          SelectedValue="{Binding DefaultTargetLanguage}"
                                          SelectedValuePath="Code"
                                          ItemTemplate="{StaticResource LanguageItemTemplate}"
                                          Style="{StaticResource SettingsComboBoxStyle}"
                                          VerticalAlignment="Center"
                                          Margin="0,2"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Translation behavior" Style="{StaticResource SettingsGroupBoxStyle}">
                            <StackPanel Margin="12,4">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Auto-detect source language" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                        <TextBlock Text="Automatically identify the source language for every translation" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" IsChecked="{Binding AutoDetectSource}"
                                                  IsEnabled="{Binding IsAutoDetectSourceEnabled}"
                                                  Width="38" Height="20" VerticalAlignment="Center" Cursor="Hand">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleSwitchStyle}">
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Auto-translate" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                        <TextBlock Text="Translate automatically as you type in the main window" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" IsChecked="{Binding AutoTranslateEnabled}"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  Width="38" Height="20" VerticalAlignment="Center" Cursor="Hand"/>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Auto-detect target language" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                        <TextBlock Text="Automatically pick the best target based on your system language" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" IsChecked="{Binding AutoDetectTargetLanguage}"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  Width="38" Height="20" VerticalAlignment="Center" Cursor="Hand"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Language pairs" Style="{StaticResource SettingsGroupBoxStyle}">
                            <StackPanel Margin="12,4">
                                <TextBlock Text="Remembered translation pairs (source → target):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,6"/>

                                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                                <ItemsControl ItemsSource="{Binding LanguagePairs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:LanguagePair}">
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1"
                                                        Command="{Binding DataContext.RemoveLanguagePairCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Padding="4,2"
                                                        ToolTip="Remove this pair">
                                                    <Path Data="M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19V4Z"
                                                          Fill="{StaticResource TextSecondaryBrush}"
                                                          Width="12" Height="12"
                                                          Stretch="Uniform"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding AvailableLanguages}"
                                              SelectedValue="{Binding NewPairSource}"
                                              SelectedValuePath="Code"
                                              ItemTemplate="{StaticResource LanguageItemTemplate}"
                                              Style="{StaticResource SettingsComboBoxStyle}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="1" Text="→" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="4,0"/>
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding AvailableLanguages}"
                                              SelectedValue="{Binding NewPairTarget}"
                                              SelectedValuePath="Code"
                                              ItemTemplate="{StaticResource LanguageItemTemplate}"
                                              Style="{StaticResource SettingsComboBoxStyle}"
                                              VerticalAlignment="Center"
                                              Margin="4,0,4,0"/>
                                    <Button Grid.Column="3" Content="+"
                                            Command="{Binding AddLanguagePairCommand}"
                                            Style="{StaticResource IconButtonStyle}"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Padding="8,2" FontSize="14"
                                            ToolTip="Add language pair"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Services" Style="{StaticResource SettingsGroupBoxStyle}">
                            <Grid Margin="12,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Default provider:" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" 
                                          ItemsSource="{Binding AvailableProviders}"
                                          SelectedItem="{Binding DefaultProvider}"
                                          Style="{StaticResource SettingsComboBoxStyle}"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>

                    <!-- Appearance Section -->
                    <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource CategoryToVisibility}, ConverterParameter=Appearance}">
                        <GroupBox Header="Appearance" Style="{StaticResource SettingsGroupBoxStyle}">
                            <Grid Margin="12,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Font size:" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource SettingsTextBoxStyle}"
                                             VerticalAlignment="Center"
                                             Width="50"
                                             HorizontalContentAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center" Margin="4,0,0,0">
                                        <Button Content="▲" Click="IncreaseFontSize_Click" 
                                                Style="{StaticResource WindowHeaderButtonStyle}"
                                                Padding="4,0" MinHeight="12" FontSize="8"/>
                                        <Button Content="▼" Click="DecreaseFontSize_Click" 
                                                Style="{StaticResource WindowHeaderButtonStyle}"
                                                Padding="4,0" MinHeight="12" FontSize="8"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                        
                        <GroupBox Header="Font Style" Style="{StaticResource SettingsGroupBoxStyle}">
                            <Grid Margin="12,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="Font family:" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" 
                                          ItemsSource="{Binding AvailableFontFamilies}"
                                          SelectedItem="{Binding FontFamily}"
                                          Style="{StaticResource SettingsComboBoxStyle}"
                                          VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="1" Text="Font weight:" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" 
                                          ItemsSource="{Binding AvailableFontWeights}"
                                          SelectedItem="{Binding FontWeight}"
                                          Style="{StaticResource SettingsComboBoxStyle}"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>

                    <!-- Pronunciation Section -->
                    <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource CategoryToVisibility}, ConverterParameter=Pronunciation}">
                         <GroupBox Header="Provider Settings" Style="{StaticResource SettingsGroupBoxStyle}">
                            <Grid Margin="12,8,12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="Provider:" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,8"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" 
                                          ItemsSource="{Binding AvailablePronunciationProviders}"
                                          SelectedValue="{Binding PronunciationProvider}"
                                          SelectedValuePath="Name"
                                          Style="{StaticResource SettingsComboBoxStyle}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,0,8">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:PronunciationProviderInfo}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" 
                                                         Margin="0,0,6,0" 
                                                         VerticalAlignment="Center">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="{Binding BrandColor}"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Row="1" Text="Google Ai Studio API Key:" 
                                           VerticalAlignment="Center" 
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,12,8"
                                           Visibility="{Binding IsGeminiApiKeyInputEnabled, Converter={StaticResource BoolToVisibility}}"/>
                                <PasswordBox Grid.Row="1" Grid.Column="1" 
                                             x:Name="GeminiApiKeyBox"
                                             PasswordChar="•"
                                             Style="{StaticResource SettingsPasswordBoxStyle}"
                                             Margin="0,0,0,8"
                                             PasswordChanged="GeminiApiKeyBox_PasswordChanged"
                                             ToolTip="Required for Google Ai Studio provider"
                                             Visibility="{Binding IsGeminiApiKeyInputEnabled, Converter={StaticResource BoolToVisibility}}"/>

                                <TextBlock Grid.Row="2" Text="Google Cloud Platform API Key:" 
                                           VerticalAlignment="Center" 
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,12,8"
                                           Visibility="{Binding IsGcpApiKeyInputEnabled, Converter={StaticResource BoolToVisibility}}"/>
                                <PasswordBox Grid.Row="2" Grid.Column="1" 
                                             x:Name="GcpApiKeyBox"
                                             PasswordChar="•"
                                             Style="{StaticResource SettingsPasswordBoxStyle}"
                                             Margin="0,0,0,8"
                                             PasswordChanged="GcpApiKeyBox_PasswordChanged"
                                             ToolTip="Required for Google Cloud Platform provider"
                                             Visibility="{Binding IsGcpApiKeyInputEnabled, Converter={StaticResource BoolToVisibility}}"/>

                                <TextBlock Grid.Row="3" Text="ElevenLabs API Key:" 
                                           VerticalAlignment="Center" 
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,12,8"
                                           Visibility="{Binding IsElevenLabsApiKeyInputEnabled, Converter={StaticResource BoolToVisibility}}"/>
                                <PasswordBox Grid.Row="3" Grid.Column="1" 
                                             x:Name="ElevenLabsApiKeyBox"
                                             PasswordChar="•"
                                             Style="{StaticResource SettingsPasswordBoxStyle}"
                                             Margin="0,0,0,8"
                                             PasswordChanged="ElevenLabsApiKeyBox_PasswordChanged"
                                             ToolTip="Required for ElevenLabs provider"
                                             Visibility="{Binding IsElevenLabsApiKeyInputEnabled, Converter={StaticResource BoolToVisibility}}"/>

                                <TextBlock Grid.Row="4" Text="ElevenLabs Voice ID:" 
                                           VerticalAlignment="Center" 
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,12,0"
                                           Visibility="{Binding IsElevenLabsVoiceIdInputEnabled, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBox Grid.Row="4" Grid.Column="1" 
                                         x:Name="ElevenLabsVoiceIdBox"
                                         Text="{Binding ElevenLabsVoiceId, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingsTextBoxStyle}"
                                         VerticalAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Height="26"
                                         ToolTip="Voice ID from ElevenLabs (default: Rachel)"
                                         Visibility="{Binding IsElevenLabsVoiceIdInputEnabled, Converter={StaticResource BoolToVisibility}}"/>
                             </Grid>
                        </GroupBox>

                        <GroupBox Header="Single Word Lookup" Style="{StaticResource SettingsGroupBoxStyle}">
                            <StackPanel Margin="12,4">
                                <CheckBox Content="Show pronunciation" 
                                          IsChecked="{Binding ShowPronunciation}"
                                          Style="{StaticResource SettingsCheckBoxStyle}"
                                          Margin="0,4"/>
                                <TextBlock Text="Show phonetics and speaker button in the main translation popup for single words."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <!-- OCR Section -->
                    <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource CategoryToVisibility}, ConverterParameter=OCR}">
                        <GroupBox Header="OCR Settings" Style="{StaticResource SettingsGroupBoxStyle}">
                            <Grid Margin="12,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="OCR Language:" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" 
                                          ItemsSource="{Binding AvailableOcrLanguages}"
                                          SelectedItem="{Binding SelectedOcrLanguage}"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource SettingsComboBoxStyle}"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="About OCR" Style="{StaticResource SettingsGroupBoxStyle}">
                            <StackPanel Margin="12,4">
                                <TextBlock Text="OCR (Optical Character Recognition) extracts text from images and screen regions."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Draw a rectangle on screen to capture text. Uses the built-in Windows OCR engine."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Note: Requires Windows 10 1809+ and the OCR language pack installed."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <!-- About Section -->
                    <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource CategoryToVisibility}, ConverterParameter=About}">
                         <GroupBox Header="About" Style="{StaticResource SettingsGroupBoxStyle}">
                            <StackPanel Margin="12,8">
                                <TextBlock Text="QuickTranslate v1.0.0" 
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="A fast, lightweight translation tool." 
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Footer Buttons -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8">
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <Button Content="Save" 
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsDirty}"
                            MinWidth="70"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Foreground="White">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource WindowHeaderButtonStyle}">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Opacity" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4"/>
                                        <Setter Property="Background" Value="#555555"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Close" 
                            Command="{Binding CloseCommand}"
                            MinWidth="70"
                            Padding="12,6"
                            Style="{StaticResource WindowHeaderButtonStyle}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
