<UserControl x:Class="QuickTranslate.Views.DictionaryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:QuickTranslate.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>
    </UserControl.Resources>
    <Grid MinHeight="250">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search bar -->
        <Border Grid.Row="0" Padding="8,4"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0"
                Background="{StaticResource WindowBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding DictionarySearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         Padding="5,3"
                         FontSize="13"
                         CaretBrush="{StaticResource TextPrimaryBrush}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchDictionaryCommand}" CommandParameter="{Binding DictionarySearchText}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1"
                        Command="{Binding SearchDictionaryCommand}"
                        CommandParameter="{Binding DictionarySearchText}"
                        Content="Lookup"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="8,3"
                        Margin="4,0,0,0"
                        Height="24"/>
            </Grid>
        </Border>

        <!-- Dictionary content -->
        <Grid Grid.Row="1" Background="{StaticResource WindowBackgroundBrush}">

            <!-- No result state -->
            <TextBlock Text="Double-click a word or type above to look up definitions."
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Padding="20">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDictionaryResult}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Loading state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDictionaryLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Looking up word..." Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Result content -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasDictionaryResult}" Value="True"/>
                                    <Condition Binding="{Binding IsDictionaryLoading}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <Grid Margin="14,10,14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                    </Grid.ColumnDefinitions>

                    <!-- ═══ LEFT COLUMN: Word info + Translations ═══ -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">

                        <!-- Word -->
                        <TextBox Text="{Binding DictionaryWord}"
                                 FontSize="20" FontWeight="Bold"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 TextWrapping="Wrap"
                                 IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" IsTabStop="False"
                                 Padding="0" VerticalAlignment="Top"/>

                        <!-- Phonetic + Part of Speech -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBox FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"
                                     FontFamily="Consolas"
                                     Visibility="{Binding DictionaryPhonetic, Converter={StaticResource StringToVis}}"
                                     Text="{Binding DictionaryPhonetic, StringFormat='/{0}/'}"
                                     IsReadOnly="True" BorderThickness="0"
                                     Background="Transparent" IsTabStop="False"
                                     Padding="0" VerticalAlignment="Center"
                                     HorizontalAlignment="Left"/>
                            <TextBlock Text=" " FontSize="14"
                                       Visibility="{Binding DictionaryPhonetic, Converter={StaticResource StringToVis}}"/>
                            <TextBlock Text="·" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"
                                       Visibility="{Binding DictionaryPhonetic, Converter={StaticResource StringToVis}}"/>
                            <TextBlock Text=" " FontSize="14"
                                       Visibility="{Binding DictionaryPhonetic, Converter={StaticResource StringToVis}}"/>
                            <TextBox Text="{Binding DictionaryPartOfSpeech}"
                                     FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"
                                     FontStyle="Italic"
                                     Visibility="{Binding DictionaryPartOfSpeech, Converter={StaticResource StringToVis}}"
                                     IsReadOnly="True" BorderThickness="0"
                                     Background="Transparent" IsTabStop="False"
                                     Padding="0" VerticalAlignment="Center"
                                     HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Definition -->
                        <TextBox Text="{Binding DictionaryDefinition}"
                                 FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"
                                 TextWrapping="Wrap"
                                 Margin="0,8,0,0"
                                 Visibility="{Binding DictionaryDefinition, Converter={StaticResource StringToVis}}"
                                 IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" IsTabStop="False"
                                 Padding="0" VerticalAlignment="Top"/>

                        <!-- Separator -->
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12"/>

                        <!-- Translations accordion -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TranslationEntries.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Header -->
                            <Border Padding="0,6" Cursor="Hand" Background="Transparent">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding ToggleTranslationsCommand}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0"
                                          Data="M2,0 L6,4 L2,8"
                                          Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5"
                                          Fill="Transparent"
                                          Stretch="Uniform" Width="7" Height="7"
                                          VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </Path.RenderTransform>
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTranslationsExpanded}" Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Grid.Column="1" Text="TRANSLATIONS"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="6,0"/>
                                    <TextBlock Grid.Column="2"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <Binding Path="TranslationEntries.Count" StringFormat="({0})"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- Content -->
                            <ItemsControl ItemsSource="{Binding TranslationEntries}" Margin="13,0,0,6">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTranslationsExpanded}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Definitions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding MainTerm}"
                                                             FontSize="15"
                                                             Foreground="{StaticResource TextPrimaryBrush}"
                                                             Margin="0,0,12,4"
                                                             IsReadOnly="True" BorderThickness="0"
                                                             Background="Transparent" IsTabStop="False"
                                                             Padding="0" VerticalAlignment="Center"
                                                             HorizontalAlignment="Left"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Grid.Column="1" Width="1"
                            Background="{StaticResource BorderBrush}"
                            VerticalAlignment="Stretch" Margin="0,2"/>

                    <!-- ═══ RIGHT COLUMN: Definitions + Examples ═══ -->
                    <StackPanel Grid.Column="2" Margin="10,0,0,0">

                        <!-- Definitions accordion -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DefinitionEntries.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Header -->
                            <Border Padding="0,6" Cursor="Hand" Background="Transparent">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding ToggleDefinitionsCommand}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0"
                                          Data="M2,0 L6,4 L2,8"
                                          Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5"
                                          Fill="Transparent"
                                          Stretch="Uniform" Width="7" Height="7"
                                          VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </Path.RenderTransform>
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDefinitionsExpanded}" Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Grid.Column="1" Text="DEFINITIONS"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="6,0"/>
                                    <TextBlock Grid.Column="2"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <Binding Path="DefinitionEntries.Count" StringFormat="({0})"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- Content -->
                            <StackPanel Margin="13,0,0,6">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDefinitionsExpanded}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ItemsControl ItemsSource="{Binding DefinitionEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding Definitions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                                            <TextBlock Text="·" FontSize="15"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       Margin="0,0,8,0"/>
                                                            <TextBox Text="{Binding MainTerm}"
                                                                     FontSize="15"
                                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                                     TextWrapping="Wrap"
                                                                     IsReadOnly="True" BorderThickness="0"
                                                                     Background="Transparent" IsTabStop="False"
                                                                     Padding="0" VerticalAlignment="Top"
                                                                     HorizontalAlignment="Left"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                        <!-- Examples accordion -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExampleEntries.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Header -->
                            <Border Padding="0,6" Cursor="Hand" Background="Transparent">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding ToggleExamplesCommand}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0"
                                          Data="M2,0 L6,4 L2,8"
                                          Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5"
                                          Fill="Transparent"
                                          Stretch="Uniform" Width="7" Height="7"
                                          VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </Path.RenderTransform>
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExamplesExpanded}" Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Grid.Column="1" Text="EXAMPLES"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="6,0"/>
                                    <TextBlock Grid.Column="2"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <Binding Path="ExampleEntries.Count" StringFormat="({0})"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- Content -->
                            <StackPanel Margin="13,0,0,6">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExamplesExpanded}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ItemsControl ItemsSource="{Binding ExampleEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding Definitions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding MainTerm, StringFormat='&quot;{0}&quot;'}"
                                                                 FontSize="15"
                                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                                 FontStyle="Italic"
                                                                 TextWrapping="Wrap"
                                                                 Margin="0,3"
                                                                 IsReadOnly="True" BorderThickness="0"
                                                                 Background="Transparent" IsTabStop="False"
                                                                 Padding="0" VerticalAlignment="Top"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
