<UserControl x:Class="QuickTranslate.Views.DictionaryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MinHeight="260" MaxHeight="300">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search bar row -->
        <Border Grid.Row="0" Padding="12,8"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Background="#1a1a1a">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0"
                          Data="M8,8 A5,5 0 1,1 8,18 A5,5 0 1,1 8,8 M12,12 L16,16"
                          Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                          Fill="Transparent"
                          Stretch="Uniform" Width="14" Height="14"
                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding DictionarySearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Background="#181818" BorderBrush="#383838"
                             BorderThickness="1"
                             Foreground="#e3e3e3"
                             Padding="6,4"
                             FontSize="11"
                             CaretBrush="#e3e3e3"/>
                </Grid>

                <Button Grid.Column="1"
                        Command="{Binding SearchDictionaryCommand}"
                        CommandParameter="{Binding DictionarySearchText}"
                        Content="Lookup"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="12,4"
                        Margin="8,0,0,0"
                        Height="26"/>
            </Grid>
        </Border>

        <!-- Dictionary content -->
        <ScrollViewer Grid.Row="1"
                      Style="{StaticResource SlimScrollViewerStyle}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>

            <!-- No result state -->
            <TextBlock Text="Select a word or type above to look up definitions."
                       Foreground="#666666" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Padding="20"
                       Visibility="{Binding HasDictionaryResult, Converter={StaticResource InverseBoolToVisibility}}"/>

            <!-- Loading state -->
            <TextBlock Text="Looking up word..."
                       Foreground="#007ACC" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Padding="20"
                        Visibility="{Binding IsDictionaryLoading, Converter={StaticResource BoolToVisibility}}"/>

            <!-- Result -->
            <Grid Visibility="{Binding HasDictionaryResult, Converter={StaticResource BoolToVisibility}}"
                  Margin="12,8">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDictionaryLoading}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Word info -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="SELECTED WORD" FontSize="9"
                               Foreground="#888888" FontWeight="Bold"/>

                    <!-- Word + speaker -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding DictionaryWord}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#f1f1f1"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Syllables -->
                    <TextBlock Text="{Binding DictionarySyllables, StringFormat='[{0}]'}"
                               FontSize="10" Foreground="#888888"
                               FontFamily="Consolas"
                               Margin="0,2,0,0"/>

                    <!-- Phonetic -->
                    <TextBlock Text="{Binding DictionaryPhonetic}"
                               FontSize="12" Foreground="#007ACC"
                               FontFamily="Consolas" FontWeight="Bold"
                               Margin="0,1,0,0"/>

                    <!-- Part of speech (inline with phonetic) -->
                    <TextBlock Text="{Binding DictionaryPartOfSpeech}"
                               FontSize="11" Foreground="#007ACC"
                               FontStyle="Italic"
                               Margin="0,1,0,0"/>

                    <!-- Definition -->
                    <TextBlock Text="{Binding DictionaryDefinition}"
                               FontSize="12" Foreground="#cccccc"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Right: Contextual usage and synonyms -->
                <StackPanel Grid.Column="1">
                    <!-- Contextual Usage box -->
                    <Border Background="#181818"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="CONTEXTUAL USAGE" FontSize="9"
                                       Foreground="#888888" FontWeight="Bold"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding DictionaryExample, StringFormat='&quot;{0}&quot;'}"
                                       FontSize="11" Foreground="#bbbbbb"
                                       FontStyle="Italic"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Synonyms -->
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="SYNONYMS" FontSize="9"
                                   Foreground="#888888" FontWeight="Bold"
                                   Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding DictionarySynonyms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#252525"
                                            BorderBrush="#383838"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,3"
                                            Margin="0,0,6,6">
                                        <TextBlock Text="{Binding}"
                                                   FontSize="10" Foreground="#007ACC"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Grid>
</UserControl>
