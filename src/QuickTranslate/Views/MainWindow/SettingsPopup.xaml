<UserControl x:Class="QuickTranslate.Views.SettingsPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#252525" BorderBrush="#444" BorderThickness="1" CornerRadius="8"
            Padding="0" Effect="{StaticResource DropShadowEffect}">
        <StackPanel Width="250">

            <!-- Popup header -->
            <Border Background="#1e1e1e" Padding="14,10" CornerRadius="8,8,0,0"
                    BorderBrush="#333" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94zM12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                          Fill="#888" Stretch="Uniform" Width="12" Height="12" Margin="0,0,8,0"/>
                    <TextBlock Text="QUICK SETTINGS" FontSize="10" FontWeight="Bold"
                               Foreground="#888" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Body -->
            <Border Padding="14,10">
                <StackPanel>

                <!-- ── General Section ── -->
                <TextBlock Text="GENERAL" FontSize="9" FontWeight="Bold"
                           Foreground="#666" Margin="0,0,0,6"/>

                <!-- Auto-translate toggle -->
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Auto-translate" Foreground="#e3e3e3" FontSize="12"/>
                        <TextBlock Text="Translate automatically as you type" Foreground="#777" FontSize="10"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" IsChecked="{Binding AutoTranslateEnabled}"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Width="38" Height="20" VerticalAlignment="Center" Cursor="Hand"/>
                </Grid>

                <!-- Auto-detect toggle -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Auto-detect language" Foreground="#e3e3e3" FontSize="12"/>
                        <TextBlock Text="Automatically identify source language" Foreground="#777" FontSize="10"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" IsChecked="{Binding AutoDetectSource}"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Width="38" Height="20" VerticalAlignment="Center" Cursor="Hand"/>
                </Grid>

                <!-- ── Providers Section ── -->
                <Rectangle Height="1" Fill="#333" Margin="0,12"/>
                <TextBlock Text="PROVIDERS" FontSize="9" FontWeight="Bold"
                           Foreground="#666" Margin="0,8,0,6"/>

                <!-- Translation Provider -->
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Translation" Foreground="#e3e3e3"
                               FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding TranslationProviders}"
                              SelectedItem="{Binding SelectedTranslationProvider}"
                              Style="{StaticResource SettingsComboBoxStyle}"
                              Height="26" FontSize="11"
                              MinWidth="110"/>
                </Grid>

                <!-- Pronunciation Provider -->
                <Grid Margin="0,6,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Pronunciation" Foreground="#e3e3e3"
                               FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding PronunciationProviders}"
                              SelectedValuePath="Name"
                              SelectedValue="{Binding SelectedPronunciationProvider}"
                              Style="{StaticResource SettingsComboBoxStyle}"
                              Height="26" FontSize="11"
                              MinWidth="110">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="6" Height="6" CornerRadius="3"
                                            Background="{Binding BrandColor}" Margin="0,0,6,0"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#e3e3e3"/>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <!-- Dictionary Provider (read-only) -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Dictionary" Foreground="#e3e3e3"
                               FontSize="12" VerticalAlignment="Center"/>
                    <Grid Grid.Column="1" Margin="0,0,0,0">
                        <Border Background="#1f1f1f" BorderBrush="#3a3a3a" BorderThickness="1"
                                CornerRadius="3" Padding="8,0,8,0" Height="26">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Offline (Local)" Foreground="#777"
                                           FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

            </StackPanel>
        </Border>
        </StackPanel>
    </Border>
</UserControl>
